# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (PENGADUAN MASYARAKAT / JAKI-STYLE)
# ==============================================================================
# Salin file ini menjadi .env.local dan isi dengan kredensial Supabase proyek Anda.

# URL Proyek Supabase (Ditemukan di: Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon Publik Supabase (Ditemukan di: Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Kunci Rahasia Service Role (HANYA digunakan di Server Actions & Route Handler backend, JANGAN diekspos ke klien)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# URL Basis Aplikasi (Gunakan http://localhost:3000 untuk pengembangan lokal)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama Bucket Penyimpanan Foto Bukti Supabase Storage
NEXT_PUBLIC_STORAGE_BUCKET=evidence-photos
